// University Examination System — data model.
//
// Conventions:
//   - Int autoincrement `id` for joins; `publicId` (uuid) for anything exposed in a URL.
//   - createdAt / updatedAt everywhere; deletedAt where a row is academic (soft delete only).
//   - Every foreign key is indexed. Composite indexes on hot paths.
//   - CHECK constraints (marks >= 0, semester number 1..12, ...) live in the migration SQL.
//
// Academic hierarchy:
//   Faculty → Department → Program → Semester → Course → Course Part → Exam
//   A teacher is assigned to a Course Part; exams and question banks belong to the part.
//   A Batch of students is assigned to a Semester (advanced as the batch progresses); the
//   students of that batch then see every course and exam of that semester.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum RoleName {
  super_admin
  admin
  department_head
  teacher
  student
}

enum UserStatus {
  active
  suspended
}

enum DegreeType {
  bachelor
  masters
  mphil
  phd
  diploma
}

// ───────────────────────── Academic hierarchy ─────────────────────────

// A faculty groups related departments. It has a name only.
model Faculty {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments Department[]
  scopedRoles UserRole[]   @relation("FacultyScope")

  @@index([deletedAt])
}

// A department belongs to a faculty. It has a name only.
model Department {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  facultyId Int
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  faculty     Faculty    @relation(fields: [facultyId], references: [id])
  programs    Program[]
  teachers    Teacher[]
  scopedRoles UserRole[] @relation("DepartmentScope")

  @@unique([facultyId, name])
  @@index([facultyId])
  @@index([deletedAt])
}

// A program inside a department (e.g. Honours, Masters).
model Program {
  id            Int        @id @default(autoincrement())
  publicId      String     @unique @default(uuid())
  departmentId  Int
  name          String
  degreeType    DegreeType
  durationYears Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  department Department @relation(fields: [departmentId], references: [id])
  batches    Batch[]
  semesters  Semester[]

  @@index([departmentId])
  @@index([deletedAt])
}

// A semester inside a program. Courses hang off it; batches are assigned to it.
model Semester {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  programId Int
  number    Int
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  program Program  @relation(fields: [programId], references: [id])
  courses Course[]
  batches Batch[]  @relation("BatchCurrentSemester")

  @@unique([programId, number])
  @@index([programId])
}

// A cohort of students in one program. `currentSemesterId` is where the batch sits now;
// admins advance it as the batch progresses. Students of the batch see that semester's work.
model Batch {
  id                Int       @id @default(autoincrement())
  publicId          String    @unique @default(uuid())
  programId         Int
  currentSemesterId Int?
  name              String
  year              Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  program         Program   @relation(fields: [programId], references: [id])
  currentSemester Semester? @relation("BatchCurrentSemester", fields: [currentSemesterId], references: [id])
  students        Student[]

  @@unique([programId, name])
  @@index([programId])
  @@index([currentSemesterId])
  @@index([deletedAt])
}

// A course inside a semester.
model Course {
  id         Int       @id @default(autoincrement())
  publicId   String    @unique @default(uuid())
  semesterId Int
  code       String
  name       String
  credit     Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  semester Semester     @relation(fields: [semesterId], references: [id])
  parts    CoursePart[]

  @@unique([semesterId, code])
  @@index([semesterId])
  @@index([deletedAt])
}

// A part of a course (e.g. Part A, Part B). A single teacher is assigned; exams and
// question banks belong to the part. Reassigning a teacher just updates assignedTeacherId.
model CoursePart {
  id                Int       @id @default(autoincrement())
  publicId          String    @unique @default(uuid())
  courseId          Int
  assignedTeacherId Int?
  name              String
  marksWeight       Float
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  course          Course         @relation(fields: [courseId], references: [id])
  assignedTeacher Teacher?       @relation(fields: [assignedTeacherId], references: [id])
  questionBanks   QuestionBank[]
  exams           Exam[]

  @@unique([courseId, name])
  @@index([courseId])
  @@index([assignedTeacherId])
  @@index([deletedAt])
}

// ───────────────────────────── People & access ─────────────────────────────

model User {
  id                 Int        @id @default(autoincrement())
  publicId           String     @unique @default(uuid())
  username           String     @unique
  email              String?    @unique
  passwordHash       String
  displayName        String
  status             UserStatus @default(active)
  mustChangePassword Boolean    @default(true)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  student   Student?
  teacher   Teacher?
  roles     UserRole[]
  auditLogs AuditLog[] @relation("ActorAudit")

  @@index([status])
  @@index([deletedAt])
}

model Student {
  id                 Int       @id @default(autoincrement())
  publicId           String    @unique @default(uuid())
  userId             Int       @unique
  studentId          String    @unique
  registrationNumber String?   @unique
  rollNumber         String?
  batchId            Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user     User          @relation(fields: [userId], references: [id])
  batch    Batch         @relation(fields: [batchId], references: [id])
  attempts ExamAttempt[]

  @@index([batchId])
}

model Teacher {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(uuid())
  userId       Int       @unique
  departmentId Int
  designation  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user          User           @relation(fields: [userId], references: [id])
  department    Department     @relation(fields: [departmentId], references: [id])
  courseParts   CoursePart[]
  createdBanks  QuestionBank[]
  createdExams  Exam[]
  gradedAnswers Answer[]

  @@index([departmentId])
}

model Role {
  id        Int      @id @default(autoincrement())
  name      RoleName @unique
  createdAt DateTime @default(now())

  userRoles UserRole[]
}

// Scoped RBAC: a role assignment may carry a faculty and/or department scope.
// Guards check both the role AND the scope.
model UserRole {
  id                Int      @id @default(autoincrement())
  userId            Int
  roleId            Int
  scopeFacultyId    Int?
  scopeDepartmentId Int?
  createdAt         DateTime @default(now())

  user            User        @relation(fields: [userId], references: [id])
  role            Role        @relation(fields: [roleId], references: [id])
  scopeFaculty    Faculty?    @relation("FacultyScope", fields: [scopeFacultyId], references: [id])
  scopeDepartment Department? @relation("DepartmentScope", fields: [scopeDepartmentId], references: [id])

  @@unique([userId, roleId, scopeFacultyId, scopeDepartmentId])
  @@index([userId])
  @@index([roleId])
}

// ─────────────────────────────── Audit ───────────────────────────────
// Append-only: the AuditService only ever inserts.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int?
  action      String
  entity      String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("ActorAudit", fields: [actorUserId], references: [id])

  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ─────────────────────────── Exams & questions ───────────────────────────

enum QuestionType {
  mcq
  written
}

// Strict lifecycle state machine — transitions enforced server-side.
enum ExamStatus {
  draft
  in_review
  approved
  changes_requested
  rejected
  published
  live
  ended
  grading
  results_published
  archived
}

// A reusable bank of questions scoped to one course part (the teacher's assigned part).
model QuestionBank {
  id                 Int       @id @default(autoincrement())
  publicId           String    @unique @default(uuid())
  coursePartId       Int
  name               String
  createdByTeacherId Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  coursePart CoursePart @relation(fields: [coursePartId], references: [id])
  createdBy  Teacher?   @relation(fields: [createdByTeacherId], references: [id])
  questions  Question[]

  @@index([coursePartId])
  @@index([deletedAt])
}

model Question {
  id          Int          @id @default(autoincrement())
  publicId    String       @unique @default(uuid())
  bankId      Int
  type        QuestionType
  text        String
  marks       Float
  explanation String?
  modelAnswer String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  bank          QuestionBank     @relation(fields: [bankId], references: [id])
  options       QuestionOption[]
  examQuestions ExamQuestion[]
  answers       Answer[]

  @@index([bankId])
  @@index([deletedAt])
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  publicId   String   @unique @default(uuid())
  questionId Int
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

// An exam belongs to a course part. Students see it when their batch's current semester
// is the semester of the part's course.
model Exam {
  id                 Int        @id @default(autoincrement())
  publicId           String     @unique @default(uuid())
  coursePartId       Int
  createdByTeacherId Int
  title              String
  instructions       String?
  startAt            DateTime
  endAt              DateTime
  durationMinutes    Int
  totalMarks         Float      @default(0)
  status             ExamStatus @default(draft)
  settings           Json
  reviewNote         String?
  publishedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  coursePart    CoursePart     @relation(fields: [coursePartId], references: [id])
  createdBy     Teacher        @relation(fields: [createdByTeacherId], references: [id])
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@index([coursePartId, status])
  @@index([status])
  @@index([deletedAt])
}

// Links an exam to a bank question. On publish, the question is SNAPSHOTTED into the snapshot*
// columns; from then on the exam serves the snapshot, so later bank edits never alter it.
model ExamQuestion {
  id            Int    @id @default(autoincrement())
  publicId      String @unique @default(uuid())
  examId        Int
  questionId    Int
  order         Int
  marksOverride Float?

  snapshotAt              DateTime?
  snapshotType            QuestionType?
  snapshotText            String?
  snapshotMarks           Float?
  snapshotExplanation     String?
  snapshotModelAnswer     String?
  snapshotOptions         Json?
  snapshotCorrectOptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam     Exam     @relation(fields: [examId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@index([examId])
}

// ───────────────────────── Attempts, answers, results ─────────────────────────

enum AttemptStatus {
  in_progress
  submitted
  grading
  graded
}

enum GradingStatus {
  pending
  awaiting_manual
  graded
}

// One row per (student, exam). UNIQUE (examId, studentId) is the DB backstop against
// duplicate attempts — concurrent starts collide here, they cannot both create an attempt.
model ExamAttempt {
  id            Int           @id @default(autoincrement())
  publicId      String        @unique @default(uuid())
  examId        Int
  studentId     Int
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  autoSubmitted Boolean       @default(false)
  status        AttemptStatus @default(in_progress)
  gradingStatus GradingStatus @default(pending)
  totalScore    Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  exam    Exam        @relation(fields: [examId], references: [id])
  student Student     @relation(fields: [studentId], references: [id])
  answers Answer[]
  result  ExamResult?

  @@unique([examId, studentId])
  @@index([examId, studentId])
  @@index([examId, status])
  @@index([createdAt])
}

// One row per (attempt, question). Autosave UPSERTs onto UNIQUE (attemptId, questionId).
model Answer {
  id                Int      @id @default(autoincrement())
  publicId          String   @unique @default(uuid())
  attemptId         Int
  questionId        Int
  selectedOptionId  String?
  writtenText       String?
  autoScore         Float?
  manualScore       Float?
  isGraded          Boolean  @default(false)
  gradedByTeacherId Int?
  feedback          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])
  gradedBy Teacher?    @relation(fields: [gradedByTeacherId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId, questionId])
  @@index([createdAt])
}

// Rollup per attempt — reports read this, never the raw answers.
model ExamResult {
  id         Int      @id @default(autoincrement())
  publicId   String   @unique @default(uuid())
  attemptId  Int      @unique
  finalScore Float
  percentage Float
  rank       Int?
  breakdown  Json?
  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt ExamAttempt @relation(fields: [attemptId], references: [id])
}
