# ─────────────────────────── App ───────────────────────────
NODE_ENV=development
API_PORT=4100
API_HOST=0.0.0.0
# Comma-separated allowlist of web origins permitted by CORS (credentials mode).
CORS_ORIGINS=http://localhost:5173
# Public URL of the SPA — used in emails and links.
WEB_APP_URL=http://localhost:5173
# Shown in the UI header, emails, and PDF/Excel exports.
INSTITUTION_NAME=University of Rajshahi
BRAND_PRIMARY=#1E3A5F

# ──────────────── Database (PostgreSQL / Prisma) ────────────────
# Runtime connection. In production point this at PgBouncer (6432) + ?pgbouncer=true.
DATABASE_URL=postgresql://exam:exam_dev_password@localhost:5436/exam?schema=public
# Direct connection (never through PgBouncer) — used by Prisma Migrate.
DIRECT_URL=postgresql://exam:exam_dev_password@localhost:5436/exam?schema=public

# ─────────────── Redis (sessions, cache, BullMQ) ───────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────── Auth / sessions ───────────────────────
# 32+ char random secret used to sign the session-id cookie. CHANGE IN PRODUCTION.
SESSION_SECRET=dev_only_session_secret_change_me_please_0123456789abcdef
SESSION_COOKIE_NAME=exam_sid
# Session lifetime in seconds (12h). Sessions are revocable (stored in Redis).
SESSION_TTL_SECONDS=43200
# Set true behind HTTPS in production (Secure cookie flag).
COOKIE_SECURE=false
# Leave blank for host-only cookie; set to your domain in production.
COOKIE_DOMAIN=

# ─────────────────────── Rate limiting ───────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Stricter bucket for the login endpoint (per IP).
LOGIN_THROTTLE_TTL_SECONDS=60
LOGIN_THROTTLE_LIMIT=10

# ─────────── Storage (report exports, import error files) ───────────
STORAGE_DIR=./storage

# ─────────────────────── Observability ───────────────────────
LOG_LEVEL=debug
SENTRY_DSN=
