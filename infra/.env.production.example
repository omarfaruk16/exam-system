# ── Production environment for infra/docker-compose.yml ──
# Copy to infra/.env on the server and fill in real values.
# NEVER commit this file with real secrets.

# ── Database ──
POSTGRES_USER=exam
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=exam_prod
POSTGRES_PORT=5432       # internal only — not exposed to host in prod

# ── Redis ──
REDIS_PORT=6379          # internal only

# ── App port (host nginx will proxy to this) ──
WEB_PORT=8080

# ── Auth / Sessions ──
# Generate: openssl rand -hex 64
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# ── Domain / CORS ──
CORS_ORIGINS=https://e-exam.ru.ac.bd
WEB_APP_URL=https://e-exam.ru.ac.bd
COOKIE_SECURE=true
COOKIE_DOMAIN=e-exam.ru.ac.bd

# ── Branding ──
INSTITUTION_NAME=University of Rajshahi
BRAND_PRIMARY=#1E3A5F

# ── Email (for "Forgot password" reset links) ──
# Leave SMTP_HOST empty to disable email — reset links are written to the API logs instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=you@gmail.com,
#   SMTP_PASS=<16-char Google App Password> (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=University Examination System <no-reply@ru.ac.bd>

# ── Observability ──
LOG_LEVEL=warn
SENTRY_DSN=

# ── Rate limiting (keep defaults unless load-testing) ──
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_SECONDS=900

# ── Two-factor auth ──
# false = admins sign in with just username + password (no authenticator app).
# Set to true to require 2FA for admin/super_admin accounts (recommended once set up).
STAFF_2FA_REQUIRED=false

# ── Maintenance ──
MAINTENANCE_MODE=false
MAINTENANCE_RESUME=

# ── App version (shown in /health) ──
APP_VERSION=1.0.0
