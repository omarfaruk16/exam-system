{
  "name": "exam-system",
  "version": "0.1.0",
  "private": true,
  "description": "University Examination System — University of Rajshahi",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @exam/api prisma:generate",
    "db:migrate": "pnpm --filter @exam/api prisma:migrate",
    "db:seed": "pnpm --filter @exam/api prisma:seed",
    "db:reset": "pnpm --filter @exam/api prisma:reset",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres redis pgbouncer",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
